Dialogue: 0,0:00:03.86,0:00:07.74,Default (Purble),NENE,0,0,0,,‫كل هذه النباتات المنزلية ‫تبدو متشابهة في نظري.
Dialogue: 0,0:00:07.74,0:00:10.10,Default (Purble),SHINOBU,0,0,0,,‫ماذا؟ هذا ليس صحيحًا.
Dialogue: 0,0:00:10.10,0:00:12.62,Default (Purble),IKO,0,0,0,,أريد ‫صبار... أريد صبار!
Dialogue: 0,0:00:12.62,0:00:15.20,Default (Purble),RIKKA,0,0,0,,‫لِمَ تتذمرين؟
Dialogue: 0,0:00:15.20,0:00:19.25,Default (Purble),RIKKA,0,0,0,,ألستِ أنت من أردت بعض الخضرة في الفصل\Nمن أجل الصيف يا نيني؟
Dialogue: 0,0:00:21.32,0:00:22.71,Default (Purble),SHINOBU,0,0,0,,‫يا يامابوكي-كن.
Dialogue: 0,0:00:22.71,0:00:24.80,Default (Purble),SHINOBU,0,0,0,,‫ما اسم هذه النبتة؟
Dialogue: 0,0:00:24.80,0:00:27.51,Default (Purble),ARISU,0,0,0,,‫هذه تسمى فيكس بنغالينشيس.
Dialogue: 0,0:00:27.51,0:00:30.05,Default (Purble),ARISU,0,0,0,,‫موطنها الأصلي في البنغال بالهند،\N‫وتُعرف أيضًا باسم شجرة البانيان.
Dialogue: 0,0:00:30.05,0:00:31.93,Default (Purble),ARISU,0,0,0,,‫مشهورة بعمرها الطويل.
Dialogue: 0,0:00:31.93,0:00:35.25,Default (Purble),ARISU,0,0,0,,و‫تتميز بالمرونة وسهولة التربية،\N‫لذا هي مثالية للمبتدئين.
Dialogue: 0,0:00:35.25,0:00:36.97,Default (Purble),ARISU,0,0,0,,‫لكن احذري من نسغها.
Dialogue: 0,0:00:35.25,0:00:37.10,Default (Purble) - Top,NENE,0,0,0,,‫مقرف! إنه مهووس بالنباتات!
Dialogue: 0,0:00:36.97,0:00:42.27,Default (Purble),ARISU,0,0,0,,‫يسبب تفاعلات حساسية،\N‫لذا ارتدي قفازات عند التعامل معه.
Dialogue: 0,0:00:37.10,0:00:37.89,Default (Purble) - Top,IKO,0,0,0,,‫صبار...
Dialogue: 0,0:00:38.27,0:00:41.86,Default (Purble) - Top,IKO,0,0,0,,‫صبار... صبار... صبار...
Dialogue: 0,0:00:41.86,0:00:42.77,Default (Purble) - Top,RIKKA,0,0,0,,...أنت
Dialogue: 0,0:00:42.77,0:00:44.38,Default (Purble) - Top,IKO,0,0,0,,‫صبار!
Dialogue: 0,0:00:42.61,0:00:44.38,Default (Purble),RIKKA,0,0,0,,‫هذه لطيفة جدًا، أليس كذلك؟
Dialogue: 0,0:00:45.47,0:00:46.78,Default (Purble) - Top,IKO,0,0,0,,‫صبار...
Dialogue: 0,0:00:45.47,0:00:47.57,Default (Purble),ARISU,0,0,0,,‫هذه نبتة الباتشيرا.
Dialogue: 0,0:00:47.57,0:00:52.46,Default (Purble),ARISU,0,0,0,,‫تشتهر بسيقانها ذات الأوراق الخمس ‫ونموها السريع.
Dialogue: 0,0:00:48.21,0:00:51.62,Default (Purble) - Top,IKO,0,0,0,,‫صبار... صبار...
Dialogue: 0,0:00:52.46,0:00:53.41,Default (Purble) - Top,IKO,0,0,0,,‫صبار...
Dialogue: 0,0:00:52.46,0:00:57.20,Default (Purble),ARISU,0,0,0,,‫تنمو كثيرًا في فصلي الربيع والصيف تحديدًا،\N‫حتى وأنتِ لا تنظرين إليها.
Dialogue: 0,0:00:53.92,0:00:57.20,Default (Purble) - Top,IKO,0,0,0,,‫صبار! صبار!
Dialogue: 0,0:00:57.71,0:00:58.95,Default (Purble) - Top,IKO,0,0,0,,‫صبار...
Dialogue: 0,0:01:00.32,0:01:04.63,Default (Purble),ARISU,0,0,0,,‫أتينا إلى هذا المتجر البعيد لشراء هذه النبتة فقط؟
Dialogue: 0,0:01:04.63,0:01:08.99,Default (Purble),SHINOBU,0,0,0,,‫اخترناها لأن ‫الأوراق الخمس تمثلنا!
Dialogue: 0,0:01:08.99,0:01:11.18,Default (Purble),RIKKA,0,0,0,,‫بل لأنها كانت رخيصة، أليس كذلك؟
Dialogue: 0,0:01:11.18,0:01:13.14,Default (Purble),IKO,0,0,0,,‫أردتُ صبارًا...
Dialogue: 0,0:01:13.14,0:01:14.86,Default (Purble),ARISU,0,0,0,,‫لكن الجو حار حقًا.
Dialogue: 0,0:01:14.86,0:01:17.22,Default (Purble),SHINOBU,0,0,0,,‫فصل الصيف على الأبواب.
Dialogue: 0,0:01:17.81,0:01:19.89,Default (Purble),NENE,0,0,0,,‫لا أريد أن أصاب بحروق الشمس.
Dialogue: 0,0:01:24.87,0:01:27.78,Default (Purble),RIKKA,0,0,0,,‫استمتعتُ بالحفل الموسيقي المصغر في ذلك اليوم.
Dialogue: 0,0:01:27.78,0:01:31.03,Default (Purble),RIKKA,0,0,0,,‫أحب حقًا غناء أغنياتي الخاصة.
Dialogue: 0,0:01:31.03,0:01:35.18,Default (Purble),RIKKA,0,0,0,,‫أريد أن أقدم عرضًا في الشارع ‫بالطريقة نفسها،
Dialogue: 0,0:01:35.18,0:01:37.33,Default (Purble),RIKKA,0,0,0,,.لكنني ما زلت خائفة
Dialogue: 0,0:01:37.33,0:01:38.49,Default (Purble),RIKKA,0,0,0,,...وأيضًا
Dialogue: 0,0:01:38.49,0:01:41.00,Default (Purble),RIKKA,0,0,0,,‫لم أتمكن من كتابة أغنية بعد.
Dialogue: 0,0:01:41.00,0:01:44.37,Default (Purble),RIKKA,0,0,0,,‫ماذا أفعل؟ اقتربت عطلة الصيف.
Dialogue: 0,0:01:45.69,0:01:49.14,Default (Purble),ARISU,0,0,0,,‫لم تحضر لي ريكا أغنية جديدة بعد.
Dialogue: 0,0:01:49.14,0:01:51.80,Default (Purble),ARISU,0,0,0,,‫صدمتها أعمق مما ظننت.
Dialogue: 0,0:01:52.14,0:01:56.89,Default (Purble),ARISU,0,0,0,,‫عليّ استكشاف خيارات أخرى على الأرجح.\N‫ما الذي يمكنني أنا؛ يامابوكي فعله؟
Dialogue: 0,0:01:58.85,0:02:01.18,Default (Purble),ARISU,0,0,0,,‫حسنٌ، أي شيء تقريبًا.
Dialogue: 0,0:02:01.71,0:02:03.16,Default (Purble),NENE,0,0,0,,‫ما هذا بحقك؟
Dialogue: 0,0:02:05.62,0:02:06.88,Default (Purble),NENE,0,0,0,,‫ما هذا الصوت؟
Dialogue: 0,0:02:06.88,0:02:09.53,Default (Purble),IKO,0,0,0,,‫أحدهم يقدم عرضًا في الشارع.
Dialogue: 0,0:02:09.53,0:02:11.90,Default (Purble),SHINOBU,0,0,0,,‫لم أسمع هذا العزف من قبل.
Dialogue: 0,0:02:12.59,0:02:15.02,Default (Purble),RIKKA,0,0,0,,!‫عذرًا، اسبقوني
Dialogue: 0,0:02:16.36,0:02:18.35,Default (Purble),SHINOBU,0,0,0,,‫ما الأمر يا ريكا-تشان؟
Dialogue: 0,0:02:18.35,0:02:19.57,Default (Purble),NENE,0,0,0,,‫هل ستذهب إلى الحمام؟
Dialogue: 0,0:02:19.57,0:02:21.83,Default (Purble),IKO,0,0,0,,‫سـ-سأصبح أم هذه الشجرة؟!
Dialogue: 0,0:02:22.18,0:02:25.86,Default (Purble),ARISU,0,0,0,,‫سمعتُ أن التنويم المغناطيسي\N‫يساعد على التغلب على الصدمات.
Dialogue: 0,0:02:25.86,0:02:27.59,Default (Purble),ARISU,0,0,0,,‫سأطلب من أختي الكبرى أن تعلمني.
Dialogue: 0,0:02:34.17,0:02:38.24,Default (Purble),RIKKA,0,0,0,,‫إنها آيكو حقًا. عرفتُ ذلك ‫من طريقة عزفها.
Dialogue: 0,0:02:38.51,0:02:41.78,Default (Purble),RIKKA,0,0,0,,‫هكذا إذن، لا تزال تفعل هذا.
Dialogue: 0,0:02:42.40,0:02:44.73,Default (Purble),RIKKA,0,0,0,,‫لا أريدها أن تراني لأن الأمر سيكون محرجًا،
Dialogue: 0,0:02:44.73,0:02:46.66,Default (Purble),RIKKA,0,0,0,,‫لكنني أريد البقاء والاستماع أكثر.
Dialogue: 0,0:02:49.59,0:02:51.48,Default (Purble),AIKO,0,0,0,,‫شكرًا لك.
Dialogue: 0,0:02:51.91,0:02:53.95,Default (Purble) - Top,AIKO,0,0,0,,إذن، ‫الأغنية التالية ستكون الأخيرة.
Dialogue: 0,0:02:53.75,0:02:55.24,Default (Purble),UNC,0,0,0,,‫يا آنسة.
Dialogue: 0,0:02:55.24,0:02:57.75,Default (Purble),UNC,0,0,0,,‫لا أحد يستمع حتى.
Dialogue: 0,0:02:57.75,0:03:00.32,Default (Purble),UNC,0,0,0,,‫ما الفائدة من الاستمرار؟
Dialogue: 0,0:03:00.32,0:03:01.49,Default (Purble),RIKKA,0,0,0,,!يا إلهي
Dialogue: 0,0:03:03.25,0:03:05.65,Default (Purble),AIKO,0,0,0,,‫اخرس أيها الأبله!
Dialogue: 0,0:03:05.65,0:03:08.10,Default (Purble),AIKO,0,0,0,,‫أفعل هذا لأنني أريد ذلك!
Dialogue: 0,0:03:08.10,0:03:11.71,Default (Purble),UNC,0,0,0,,‫ماذا قلتِ؟\N‫أنتِ سيئة في هذا، اعتزلي وحسب!
Dialogue: 0,0:03:11.71,0:03:14.01,Default (Purble),AIKO,0,0,0,,!بل أنت أيها الأحمق من لديه ذوق سيئ
Dialogue: 0,0:03:14.01,0:03:16.72,Default (Purble),AIKO,0,0,0,,‫لن أتهاون مع ‫أي شخص يهين موسيقاي!
Dialogue: 0,0:03:16.72,0:03:18.68,Default (Purble),UNC,0,0,0,,‫لن تصلي إلى أي مكان أبدًا!
Dialogue: 0,0:03:19.08,0:03:20.47,Default (Purble),AIKO,0,0,0,,!أحمق
Dialogue: 0,0:03:20.47,0:03:22.53,Default (Purble),AIKO,0,0,0,,‫لا تأتِ إلى هنا مجددًا أيها العجوز!
Dialogue: 0,0:03:23.47,0:03:26.69,Default (Purble),AIKO,0,0,0,,‫على كلٍّ، إليكم أغنيتي الأخيرة.
Dialogue: 0,0:03:26.77,0:03:29.89,Default (Purble),AIKO,0,0,0,,‫لم أكتب هذه الأغنية بمفردي.
Dialogue: 0,0:03:29.89,0:03:32.64,Default (Purble),AIKO,0,0,0,,‫كتبتُها مع صديقة لي ‫منذ زمن طويل.
Dialogue: 0,0:03:32.64,0:03:36.59,Default (Purble),AIKO,0,0,0,,‫كنا نعزف الموسيقى معًا ‫في المرحلة الإعدادية.
Dialogue: 0,0:03:36.59,0:03:38.94,Default (Purble),AIKO,0,0,0,,‫كنا متحمستين جدًا ‫عندما انتهينا من الأغنية،
Dialogue: 0,0:03:38.94,0:03:42.27,Default (Purble),AIKO,0,0,0,,‫وظننا أننا صنعنا تحفة فنية فأرسلناها إلى شركة تسجيلات.
Dialogue: 0,0:03:42.27,0:03:44.13,Default (Purble),AIKO,0,0,0,,‫وتلقينا ردًا بالفعل.
Dialogue: 0,0:03:45.64,0:03:47.75,Default (Blue),PRODUCER,0,0,0,,‫أيّكما غنت المقطع الرئيسي؟
Dialogue: 0,0:03:47.75,0:03:49.81,Default (Blue),PRODUCER,0,0,0,,‫نحتاج فقط إلى الفتاة صاحبة ذلك الصوت.
Dialogue: 0,0:03:50.32,0:03:52.85,Default (Purble),AIKO,0,0,0,,‫لكنني كنتُ سعيدة رغم ذلك،
Dialogue: 0,0:03:52.85,0:03:56.29,Default (Purble),AIKO,0,0,0,,‫لأن موسيقانا حظيت بالتقدير.
Dialogue: 0,0:03:56.29,0:03:59.78,Default (Purble),AIKO,0,0,0,,‫لهذا السبب أوكلتُ ‫كل شيء لصديقتي.
Dialogue: 0,0:03:59.78,0:04:02.05,Default (Purble),AIKO,0,0,0,,‫قلتُ لها إنه من الأفضل أن تنجح!
Dialogue: 0,0:04:02.05,0:04:05.30,Default (Purble),AIKO,0,0,0,,‫من الأفضل أن تصبح الفنانة رقم واحد\N‫في اليابان بموسيقانا!
Dialogue: 0,0:04:06.53,0:04:09.23,Default (Purble),AIKO,0,0,0,,‫لكن ما الذي فعلته تلك الحمقاء؟
Dialogue: 0,0:04:09.23,0:04:12.92,Default (Purble),AIKO,0,0,0,,!هربت من شركة التسجيلات لأنها ظنّت أن الأمر لن ينجح
Dialogue: 0,0:04:12.92,0:04:17.16,Default (Purble),AIKO,0,0,0,,شعُرت بالجبن فجأة، والآن كل ما تفعله\N.هو غناء أغاني الآيدول، يا لها من حمقاء
Dialogue: 0,0:04:17.16,0:04:21.20,Default (Purble),AIKO,0,0,0,,‫أي نوع من فتيات الإعدادية ‫تستسلم بعد فشل واحد؟!
Dialogue: 0,0:04:23.69,0:04:27.85,Default (Purble),AIKO,0,0,0,,‫لذا عليّ الاستمرار في غناء هذه الأغنية.
Dialogue: 0,0:04:28.15,0:04:30.75,Default (Purble),AIKO,0,0,0,,.لأنها تملك موهبة حقيقية
Dialogue: 0,0:04:31.50,0:04:34.01,Default (Purble),AIKO,0,0,0,,‫حتى لو لم تكن ‫الفنانة رقم واحد في اليابان،
Dialogue: 0,0:04:34.01,0:04:37.21,Default (Purble),AIKO,0,0,0,,‫لا يزال بإمكانها أن تكون رقم واحد بالنسبة لشخص ما.
Dialogue: 0,0:04:37.54,0:04:41.27,Default (Purble),AIKO,0,0,0,,‫لذا لا بأس طالما ‫أن أحدهم يفهم.
Dialogue: 0,0:04:41.27,0:04:44.97,Default (Purble),AIKO,0,0,0,,‫إذا أعجبتكم هذه الأغنية، ‫فتذكروها أرجوكم.
Dialogue: 0,0:04:45.52,0:04:46.60,Default (Purble),AIKO,0,0,0,,‫"سكون الليل".
Dialogue: 0,0:05:02.63,0:05:06.69,Narration OP 2 (Mayonka),AIKO,0,0,0,,{\fad(250,250)\be3\fs100}‫بينما غابت الشمس في البحر
Dialogue: 0,0:05:06.69,0:05:10.07,Narration OP 2 (Mayonka),AIKO,0,0,0,,{\fad(250,250)\be3\fs100}‫أطلقنا تنهيدة عميقة
Dialogue: 0,0:05:10.07,0:05:12.91,Narration OP 2 (Mayonka),AIKO,0,0,0,,{\fad(250,250)\be3\fs100}‫واستجابت لنا المحيطات
Dialogue: 0,0:05:12.91,0:05:15.69,Narration OP 2 (Mayonka),AIKO,0,0,0,,{\fad(250,250)\be3\fs100}‫بموجة بيضاء كبيرة
Dialogue: 0,0:05:16.66,0:05:20.93,Narration OP 2 (Mayonka),AIKO,0,0,0,,{\fad(250,250)\be3\fs100}‫وجرفت الريح معها
Dialogue: 0,0:05:23.76,0:05:27.52,Default (Purble),ARISU,0,0,0,,‫استمري في مشاهدة عملة الخمسة ين هذه،
Dialogue: 0,0:05:27.52,0:05:30.79,Default (Purble),ARISU,0,0,0,,‫وستجدين أن حتى الليمون يمكن أن يكون طعمه حلوًا.
Dialogue: 0,0:05:31.73,0:05:33.69,Default (Purble),IKO,0,0,0,,!صدقتُ ذلك
Dialogue: 0,0:05:33.69,0:05:35.82,Default (Purble),ARISU,0,0,0,,‫إذن، تفضلي وكلي شريحة الليمون تلك.
Dialogue: 0,0:05:37.94,0:05:39.86,Default (Purble),IKO,0,0,0,,‫حامض!
Dialogue: 0,0:05:39.86,0:05:43.07,Default (Purble),SHINOBU,0,0,0,,‫شهيق... زفير.
Dialogue: 0,0:05:43.57,0:05:45.24,Default (Purble),IKO,0,0,0,,...تدمر لساني
Dialogue: 0,0:05:45.24,0:05:47.08,Default (Purble),NENE,0,0,0,,‫لم ينجح الأمر إطلاقًا.
Dialogue: 0,0:05:47.08,0:05:50.42,Default (Purble),ARISU,0,0,0,,!ظننت أن هذه الطريقة قد تزيل صدمة ريكا
Dialogue: 0,0:05:52.28,0:05:54.18,Default (Purble),NENE,0,0,0,,‫ريكا تبدأ حفلها الموسيقي.
Dialogue: 0,0:05:55.17,0:05:57.46,Default (Purble),SHINOBU,0,0,0,,‫مر وقت طويل!
Dialogue: 0,0:05:57.46,0:05:58.88,Default (Purble),RIKKA,0,0,0,,‫أهلًا بالجميع.
Dialogue: 0,0:05:58.88,0:06:01.22,Default (Purble),RIKKA,0,0,0,,‫شكرًا لحضوركم ‫رغم الجو الحار.
Dialogue: 0,0:06:02.85,0:06:05.76,Default (Purble),RIKKA,0,0,0,,‫لنبدأ على الفور. ‫إليكم الأغنية الأولى.
Dialogue: 0,0:06:05.76,0:06:07.39,Default (Purble),F. STUDENT A,0,0,0,,ماذا؟ ما عنوانها؟
Dialogue: 0,0:06:08.33,0:06:10.26,Default (Purble),F. STUDENT B,0,0,0,,‫ماذا ستغني يا ترى؟
Dialogue: 0,0:06:25.38,0:06:28.87,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫بينما غابت الشمس في البحر
Dialogue: 0,0:06:26.35,0:06:28.75,Default (Purble),ARISU,0,0,0,,‫ما هذه الأغنية؟
Dialogue: 0,0:06:28.75,0:06:31.51,Default (Purble),ARISU,0,0,0,,لا يمكن! أهي أغنية أصلية؟
Dialogue: 0,0:06:28.87,0:06:32.35,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫أطلقنا تنهيدة عميقة
Dialogue: 0,0:06:32.35,0:06:35.00,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫واستجابت لنا المحيطات
Dialogue: 0,0:06:33.99,0:06:35.58,Default (Purble),F. STUDENT C,0,0,0,,‫ما هذه الأغنية؟
Dialogue: 0,0:06:35.00,0:06:38.66,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫بموجة بيضاء كبيرة
Dialogue: 0,0:06:36.83,0:06:38.84,Default (Purble),F. STUDENT D,0,0,0,,‫أردتُ الأغاني المعتادة.
Dialogue: 0,0:06:38.66,0:06:45.09,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫وجرفت الريح معها
Dialogue: 0,0:06:39.10,0:06:41.33,Default (Purble),F. STUDENT E,0,0,0,,‫لا أشعر أنها أغنيتها.
Dialogue: 0,0:06:42.94,0:06:46.39,Default (Purble),F. STUDENT F,0,0,0,,.لكنّي أُفضل أغنيتها هذه
Dialogue: 0,0:06:45.09,0:06:48.49,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫بعد أن ودعناها
Dialogue: 0,0:06:48.49,0:06:52.70,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫قطعنا وعدًا بلا سبب
Dialogue: 0,0:06:52.70,0:06:53.76,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}...أجل
Dialogue: 0,0:06:55.10,0:06:58.54,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫السكون يسيطر على الليل
Dialogue: 0,0:06:58.54,0:07:02.23,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫عندما يسيطر السكون على الليل
Dialogue: 0,0:07:02.23,0:07:08.49,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫نشعر وكأنه لا يوجد أحد آخر ‫في العالم سوانا
Dialogue: 0,0:07:08.49,0:07:11.73,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫البحر يمتزج بالسماء
Dialogue: 0,0:07:11.73,0:07:15.55,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫عندما يمتزج البحر بهدوء في السماء
Dialogue: 0,0:07:15.55,0:07:20.39,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫‫أعلم أننا نحن الاثنين فقط
Dialogue: 0,0:07:20.39,0:07:24.68,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫لكنني ما زلتُ أهمس لكِ
Dialogue: 0,0:07:24.68,0:07:28.26,Default (Purble),ARISU,0,0,0,,‫متى كتبت أغنية كهذه؟
Dialogue: 0,0:07:25.19,0:07:33.17,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫آه، في سكون الليل
Dialogue: 0,0:07:28.26,0:07:31.47,Default (Purble),ARISU,0,0,0,,‫والأكثر من ذلك، فعلتها بمفردها،\N‫دون مساعدة مني أنا؛ يامابوكي؟
Dialogue: 0,0:07:34.89,0:07:36.64,Default (Purble),ARISU,0,0,0,,‫ريكا!
Dialogue: 0,0:07:36.64,0:07:39.86,Default (Purble),ARISU,0,0,0,,‫متى كتبتِ تلك الأغنية الأصلية؟
Dialogue: 0,0:07:39.88,0:07:41.40,Default (Purble),ARISU,0,0,0,,.إنها رائعة جدًّا
Dialogue: 0,0:07:41.40,0:07:43.40,Default (Purble),ARISU,0,0,0,,‫يبدو أنني استهنتُ بكِ!
Dialogue: 0,0:07:43.40,0:07:47.03,Default (Purble),ARISU,0,0,0,,‫نضجتِ كثيرًا حين لم أكن أنظر إذن!
Dialogue: 0,0:07:47.03,0:07:48.87,Default (Purble),RIKKA,0,0,0,,‫حقًا.
Dialogue: 0,0:07:48.87,0:07:51.33,Default (Purble),RIKKA,0,0,0,,‫لم تمنحني ‫اهتمامًا كافيًا مؤخرًا.
Dialogue: 0,0:07:52.47,0:07:54.34,Default (Purble),RIKKA,0,0,0,,...حسن
Dialogue: 0,0:07:54.34,0:07:57.42,Default (Purble),RIKKA,0,0,0,,‫في هذه الأغنية، توقفتُ عن الاهتمام ‫بإرضاء الجميع.
Dialogue: 0,0:07:57.42,0:07:59.63,Default (Purble),RIKKA,0,0,0,,‫كتبتها لشخص مميز بالنسبة لي.
Dialogue: 0,0:07:59.63,0:08:01.67,Default (Purble),RIKKA,0,0,0,,إلى ‫صديقتي المفضلة...
Dialogue: 0,0:08:02.92,0:08:04.77,Default (Purble),RIKKA,0,0,0,,‫وإضافة أخرى.
Dialogue: 0,0:08:09.06,0:08:10.93,Default (Purble),ARISU,0,0,0,,إضافة؟
Dialogue: 0,0:09:44.74,0:09:47.23,Default (Purble),ARISU,0,0,0,,‫لدينا موعد ومكان ‫لعرض الشارع!
Dialogue: 0,0:09:47.23,0:09:50.14,Default (Purble),ARISU,0,0,0,,‫حجزتُ مكانًا أيضًا.\N‫الآن نحتاج فقط إلى أغانيكِ.
Dialogue: 0,0:09:50.14,0:09:54.69,Default (Purble),ARISU,0,0,0,,‫الآن، أطربي أذني أنا؛ يامابوكي،\N‫بقوة أغانيكِ الجديدة!
Dialogue: 0,0:09:54.69,0:09:56.03,Default (Purble),NENE,0,0,0,,‫اصمت!
Dialogue: 0,0:09:56.33,0:09:58.91,Default (Purble),NENE,0,0,0,,‫ريكا تعمل على أغنية الآن.
Dialogue: 0,0:09:58.91,0:09:59.69,Default (Purble),ARISU,0,0,0,,‫أعتذر.
Dialogue: 0,0:09:59.69,0:10:02.47,Default (Purble),IKO,0,0,0,,.وفي الأساس، صوتك العادي مرتفع بما يكفي يا بوكي
Dialogue: 0,0:10:02.47,0:10:04.83,Default (Purble),ARISU,0,0,0,,‫ألم تقولي إنكِ انتهيتِ؟
Dialogue: 0,0:10:04.83,0:10:06.88,Default (Purble),RIKKA,0,0,0,,‫لا تزال هناك أغنية واحدة.
Dialogue: 0,0:10:06.88,0:10:10.85,Default (Purble),RIKKA,0,0,0,,‫أخطط لوضع خمس أغانٍ في القرص المضغوط\N‫الذي سأبيعه في العرض.
Dialogue: 0,0:10:10.85,0:10:14.09,Default (Purble),RIKKA,0,0,0,,‫لكنني لا أستطيع إنهاء الأغنية الأخيرة.
Dialogue: 0,0:10:14.09,0:10:18.22,Default (Purble),ARISU,0,0,0,,‫لكن بالنظر إلى أنكِ لم تتمكني من الكتابة\N‫على الإطلاق من قبل، فهذا تقدم جيد.
Dialogue: 0,0:10:18.22,0:10:19.97,Default (Purble),ARISU,0,0,0,,‫أنتِ تبلين حسنًا.
Dialogue: 0,0:10:21.45,0:10:24.84,Default (Purble),ARISU,0,0,0,,!أنتِ! مدحتك ومن ثم تعامليني ببرود؟
Dialogue: 0,0:10:24.84,0:10:27.52,Default (Purble),IKO,0,0,0,,‫ريكا ليست فتاة سهلة المراس.
Dialogue: 0,0:10:27.94,0:10:30.70,Default (Purble),RIKKA,0,0,0,,‫صحيح، انتهيتُ من مسودة غلاف القرص المضغوط.
Dialogue: 0,0:10:30.70,0:10:32.09,Default (Purble),SHINOBU,0,0,0,,!كم أود رؤيته
Dialogue: 0,0:10:33.03,0:10:34.32,Default (Purble),RIKKA,0,0,0,,‫ما رأيكم؟
Dialogue: 0,0:10:34.48,0:10:36.20,Default (Purble),ARISU,0,0,0,,‫هل تكرهين الأرانب؟
Dialogue: 0,0:10:36.20,0:10:38.79,Default (Purble),RIKKA,0,0,0,,‫هذه علامة النصر، وليست أرنبًا.
Dialogue: 0,0:10:38.79,0:10:40.24,Default (Purble),ARISU,0,0,0,,‫إذن، ما معنى هذا؟
Dialogue: 0,0:10:40.24,0:10:41.50,Default (Purble),RIKKA,0,0,0,,...لا شيء
Dialogue: 0,0:10:42.70,0:10:45.25,Default (Purble),RIKKA,0,0,0,,‫هذه العلامة هي علامة التحدي.
Dialogue: 0,0:10:45.25,0:10:48.53,Default (Purble),RIKKA,0,0,0,,‫سأحرص على انتشاره ‫في جميع أنحاء اليابان.
Dialogue: 0,0:10:49.46,0:10:52.84,Default (Purble),SHINOBU,0,0,0,,‫يا إلهي، نوعًا ما بدأتُ أشعر بالتوتر.
Dialogue: 0,0:10:52.84,0:10:55.01,Default (Purble),NENE,0,0,0,,‫سنأتي جميعًا لمشاهدة عرضكِ، حسنٌ؟
Dialogue: 0,0:10:55.51,0:10:57.33,Default (Purble),RIKKA,0,0,0,,‫بخصوص ذلك...
Dialogue: 0,0:10:57.33,0:10:58.74,Default (Purble),RIKKA,0,0,0,,‫في هذا العرض،
Dialogue: 0,0:10:58.74,0:11:01.47,Default (Purble),RIKKA,0,0,0,,‫أود أن أقدمه دون مساعدتكن.
Dialogue: 0,0:11:03.16,0:11:07.44,Default (Purble),RIKKA,0,0,0,,‫وجودكن سيجعلني ‫سعيدة ويساعدني على الاسترخاء،
Dialogue: 0,0:11:07.44,0:11:10.90,Default (Purble),RIKKA,0,0,0,,‫لكن إذا اعتدتُ على ذلك كثيرًا،\N‫فلن تكون هناك فائدة من هذا العرض.
Dialogue: 0,0:11:10.90,0:11:12.44,Default (Purble),SHINOBU,0,0,0,,‫فهمت.
Dialogue: 0,0:11:12.44,0:11:15.53,Default (Purble),SHINOBU,0,0,0,,‫هذا مؤسف، لكن أظن ‫أنه لمصلحتكِ.
Dialogue: 0,0:11:15.53,0:11:17.16,Default (Purble),IKO,0,0,0,,‫حسنٌ، فهمت.
Dialogue: 0,0:11:17.16,0:11:19.37,Default (Purble),NENE,0,0,0,,‫لكننا سنكون في العرض التالي، حسنٌ؟
Dialogue: 0,0:11:20.25,0:11:21.62,Default (Purble),NENE,0,0,0,,‫بالمناسبة...
Dialogue: 0,0:11:21.62,0:11:24.62,Default (Purble),NENE,0,0,0,,‫كيف أحرزتِ تقدمًا مفاجئًا\N‫بعد أن كنتِ عالقة لفترة طويلة؟
Dialogue: 0,0:11:24.62,0:11:27.25,Default (Purble),NENE,0,0,0,,‫هل وجدتِ حيلة لكتابة الأغاني\N‫أو شيئًا من هذا القبيل؟
Dialogue: 0,0:11:27.25,0:11:28.42,Default (Purble),RIKKA,0,0,0,,حيلة؟
Dialogue: 0,0:11:29.38,0:11:33.27,Default (Purble),RIKKA,0,0,0,,‫طوال هذا الوقت، كنتُ أحاول كتابة\N‫أغانٍ تروق لكثير من الناس.
Dialogue: 0,0:11:33.27,0:11:36.91,Default (Purble),RIKKA,0,0,0,,‫"أغانٍ لا أخجل منها و‫أغانٍ يمكن أن تباع بالفعل."
Dialogue: 0,0:11:36.91,0:11:40.51,Default (Purble),RIKKA,0,0,0,,‫هذا ما كنتُ أحاول فعله،\N‫لكن الأمر لم يسر على ما يرام.
Dialogue: 0,0:11:40.51,0:11:45.44,Default (Purble),RIKKA,0,0,0,,لكن ‫عندما حاولتُ كتابتها وأنا أتخيل\N‫الشخص الذي أهديها له،
Dialogue: 0,0:11:45.44,0:11:48.47,Default (Purble),RIKKA,0,0,0,,‫جاءت الكلمات والألحان ‫بشكل طبيعي.
Dialogue: 0,0:11:48.47,0:11:53.07,Default (Purble),RIKKA,0,0,0,,‫عندما أفكر في الأمر، لم أكن أصنع\N‫الموسيقى لإرسال رسالة ما.
Dialogue: 0,0:11:53.07,0:11:57.74,Default (Purble),RIKKA,0,0,0,,‫بل كنت أصنعها لأنني أردتُ\N‫أن يستمع هذا الشخص إلى أغنياتي.
Dialogue: 0,0:11:57.74,0:12:02.49,Default (Purble),RIKKA,0,0,0,,‫لكن قلمي توقف عن الحركة\N‫أثناء كتابة هذه الأغنية الأخيرة.
Dialogue: 0,0:12:02.49,0:12:03.66,Default (Purble),IKO,0,0,0,,‫لِمَ؟
Dialogue: 0,0:12:05.29,0:12:07.29,Default (Purble),RIKKA,0,0,0,,‫إذا أردتُ قول شيء بحق،
Dialogue: 0,0:12:07.29,0:12:11.04,Default (Purble),RIKKA,0,0,0,,‫فعليّ أن أخبرهم مباشرة ‫بدلًا من استخدام موسيقاي.
Dialogue: 0,0:12:12.85,0:12:15.65,Default (Purble),ARISU,0,0,0,,‫فهمت، وصلتْ إلى طريق مسدود.
Dialogue: 0,0:12:15.65,0:12:21.64,Default (Purble),ARISU,0,0,0,,‫كمنتج، يجب أن أحل هذا\N‫وأجعلها تكتب أفضل أغنية على الإطلاق.
Dialogue: 0,0:12:22.00,0:12:23.00,Default (Purble),ARISU,0,0,0,,‫ريكا.
Dialogue: 0,0:12:23.49,0:12:25.85,Default (Purble),ARISU,0,0,0,,‫هل هناك أي شيء يمكنني فعله من أجلكِ؟
Dialogue: 0,0:12:25.85,0:12:29.55,Default (Purble),ARISU,0,0,0,,‫يمكنني أن أحضر لكِ أي شيء ترغبين به،\N‫سواء كان مكانًا أو موقفًا أو أشخاصًا.
Dialogue: 0,0:12:29.55,0:12:31.80,Default (Purble),NENE,0,0,0,,.يا إلهي! ‫تبدو كرائد أعمال صغير
Dialogue: 0,0:12:31.80,0:12:33.21,Default (Purble),RIKKA,0,0,0,,أي شيءٍ حقًّا؟
Dialogue: 0,0:12:33.21,0:12:36.03,Default (Purble),ARISU,0,0,0,,‫بالطبع! بالنسبة لي أنا؛ يامابوكي، ‫لا شيء مستحيل!
Dialogue: 0,0:12:36.20,0:12:37.32,Default (Purble),RIKKA,0,0,0,,‫في هذه الحالة...
Dialogue: 0,0:12:44.95,0:12:47.37,Default (Purble),RIKKA,0,0,0,,‫يامابوكي-كن، تعال هنا.
Dialogue: 0,0:12:47.37,0:12:50.08,Default (Purble),ARISU,0,0,0,,‫قلتُ إنني أستطيع أن أحضر لكِ أي شيء...
Dialogue: 0,0:12:50.08,0:12:53.65,Default (Purble),ARISU,0,0,0,,‫لكن لِمَ تطلبين التحدث معي ‫بجانب الشاطئ ليلًا؟
Dialogue: 0,0:12:53.65,0:12:58.17,Default (Purble),RIKKA,0,0,0,,‫اعتدتُ كتابة الأغاني ‫في منتصف الليل هكذا.
Dialogue: 0,0:12:58.17,0:13:00.47,Default (Purble),RIKKA,0,0,0,,‫لذا ظننتُ أن وجودي هنا قد يساعد.
Dialogue: 0,0:13:01.03,0:13:02.97,Default (Purble),RIKKA,0,0,0,,‫تحدث معي قليلًا.
Dialogue: 0,0:13:04.12,0:13:05.68,Default (Purble),RIKKA,0,0,0,,‫تفضل اجلس بجانبي.
Dialogue: 0,0:13:17.42,0:13:19.74,Default (Purble),RIKKA,0,0,0,,‫بخصوص ما قلتِه في وقت سابق اليوم...
Dialogue: 0,0:13:19.74,0:13:24.26,Default (Purble),RIKKA,0,0,0,,‫"صنع الموسيقى لشخص واحد فقط".\N‫هذه طريقة جيدة للتعامل مع الأمر.
Dialogue: 0,0:13:24.26,0:13:29.46,Default (Purble),RIKKA,0,0,0,,‫على سبيل المثال، يُفترض أن بيتهوفن\N‫أهدى "من أجل إليز" لشخص أحبه،
Dialogue: 0,0:13:29.46,0:13:31.71,Default (Purble),RIKKA,0,0,0,,‫ولا تزال محبوبة ‫بعد 200 عام.
Dialogue: 0,0:13:31.93,0:13:35.59,Default (Purble),RIKKA,0,0,0,,‫من المدهش أنكِ اكتشفتِ ‫هذه الطريقة بنفسكِ.
Dialogue: 0,0:13:35.59,0:13:37.35,Default (Purble),RIKKA,0,0,0,,.أحسنتِ عملًا يا ريكا
Dialogue: 0,0:13:37.96,0:13:39.13,Default (Purble),RIKKA,0,0,0,,‫إذن...
Dialogue: 0,0:13:39.13,0:13:41.01,Default (Purble),RIKKA,0,0,0,,‫لمن تهدين تلك الأغاني؟
Dialogue: 0,0:13:41.01,0:13:43.95,Default (Purble),RIKKA,0,0,0,,ماذا؟ ‫أخجل من قول ذلك.
Dialogue: 0,0:13:44.80,0:13:48.68,Default (Purble),RIKKA,0,0,0,,‫لنقل إنه شخص ابتعدتُ ‫عنه ذات مرة بسبب الإحراج،
Dialogue: 0,0:13:49.00,0:13:52.75,Default (Purble),RIKKA,0,0,0,,‫والآن أحتاج إلى استجماع الشجاعة\N‫لأخبره بمشاعري... ربما؟
Dialogue: 0,0:13:52.75,0:13:54.27,Default (Purble),ARISU,0,0,0,,‫فهمت.
Dialogue: 0,0:13:54.27,0:13:57.07,Default (Purble),ARISU,0,0,0,,‫لا بد أنها تتحدث عن ‫صديقتها تلك، آيكو.
Dialogue: 0,0:13:57.07,0:13:59.90,Default (Purble),ARISU,0,0,0,,‫اختلفتا ‫بسبب الأساليب الموسيقية.
Dialogue: 0,0:14:00.06,0:14:00.99,Default (Purble),ARISU,0,0,0,,!إذن
Dialogue: 0,0:14:00.99,0:14:05.05,Default (Purble),ARISU,0,0,0,,‫ما الذي تحاولين قوله ‫لهذا الشخص من خلال موسيقاكِ؟
Dialogue: 0,0:14:05.87,0:14:07.29,Default (Purble),RIKKA,0,0,0,,‫تريدني أن أخبرك هنا؟
Dialogue: 0,0:14:07.29,0:14:08.97,Default (Purble),ARISU,0,0,0,,‫لن أعرف ما لم تخبريني.
Dialogue: 0,0:14:11.91,0:14:13.34,Default (Purble),RIKKA,0,0,0,,‫"أحبك".
Dialogue: 0,0:14:16.02,0:14:21.29,Default (Purble),ARISU,0,0,0,,‫هذا مباشر جدًا، لكنها تريد ‫نقل حبها لصديقتها.
Dialogue: 0,0:14:22.38,0:14:24.39,Default (Purble),ARISU,0,0,0,,‫ما الأمر؟ هل تشعرين بتوعك؟
Dialogue: 0,0:14:24.39,0:14:25.55,Default (Purble),RIKKA,0,0,0,,‫ليس حقًا.
Dialogue: 0,0:14:25.55,0:14:28.46,Default (Purble),ARISU,0,0,0,,يا ‫ريكا، ‫هل يمكنني إلقاء نظرة على كلماتكِ؟
Dialogue: 0,0:14:29.32,0:14:30.60,Default (Purble),ARISU,0,0,0,,‫وإلا فلن أعرف شيئًا.
Dialogue: 0,0:14:30.60,0:14:31.80,Default (Purble),RIKKA,0,0,0,,‫لا، لكن...
Dialogue: 0,0:14:31.80,0:14:33.98,Default (Purble),ARISU,0,0,0,,لماذا تشعرين بكل هذا الخجل؟
Dialogue: 0,0:14:37.77,0:14:38.78,Default (Purble),RIKKA,0,0,0,,‫تفضل.
Dialogue: 0,0:14:38.78,0:14:39.65,Default (Purble),ARISU,0,0,0,,‫حسنٌ.
Dialogue: 0,0:14:41.14,0:14:42.40,Default (Purble),ARISU,0,0,0,,‫فهمت.
Dialogue: 0,0:14:43.11,0:14:45.07,Default (Purble),ARISU,0,0,0,,‫هل تتهربين عن قصد؟
Dialogue: 0,0:14:45.53,0:14:49.75,Default (Purble),ARISU,0,0,0,,‫هذه الكلمات مجردة جدًا\N‫وتتجنب التعبير عن أي شيء مباشرة.
Dialogue: 0,0:14:49.75,0:14:53.93,Default (Purble),ARISU,0,0,0,,‫لن تصل الرسالة هكذا.\N‫ما الذي تحبينه فيهم بالضبط؟
Dialogue: 0,0:14:54.85,0:14:57.42,Default (Purble),RIKKA,0,0,0,,...حـ-حـ-حسنٌ
Dialogue: 0,0:14:57.42,0:15:01.90,Default (Purble),RIKKA,0,0,0,,‫كانوا مستمعين جيدين ‫لي في وقت متأخر من الليل...
Dialogue: 0,0:15:01.90,0:15:05.06,Default (Purble),RIKKA,0,0,0,,‫وشجعوني على متابعة حلمي.
Dialogue: 0,0:15:05.06,0:15:09.39,Default (Purble),RIKKA,0,0,0,,‫استمتعتُ حقًا بالحديث معهم، ‫وقد منحوني الأمل.
Dialogue: 0,0:15:09.65,0:15:12.23,Default (Purble),ARISU,0,0,0,,‫ماذا أيضًا؟ أخبريني المزيد.
Dialogue: 0,0:15:13.50,0:15:15.60,Default (Purble),RIKKA,0,0,0,,‫إنـ-إنهم لطفاء...
Dialogue: 0,0:15:15.60,0:15:16.42,Default (Purble),ARISU,0,0,0,,!حسنٌ حسنٌ
Dialogue: 0,0:15:16.42,0:15:18.32,Default (Purble),RIKKA,0,0,0,,‫ولديهم صوت مريح.
Dialogue: 0,0:15:18.32,0:15:19.86,Default (Purble),ARISU,0,0,0,,هيا، ‫استمري!
Dialogue: 0,0:15:20.93,0:15:22.61,Default (Purble),RIKKA,0,0,0,,‫لكن الأهم من ذلك...
Dialogue: 0,0:15:22.61,0:15:26.70,Default (Purble),RIKKA,0,0,0,,‫هو أنهم انتظروني كل هذا الوقت ‫بعد أن هربتُ منهم.
Dialogue: 0,0:15:26.70,0:15:28.87,Default (Purble),ARISU,0,0,0,,‫يا له من شخص مراعٍ!
Dialogue: 0,0:15:28.87,0:15:30.99,Default (Purble),ARISU,0,0,0,,.يمكنك التعبير عن مشاعرك في النهاية إذن
Dialogue: 0,0:15:30.99,0:15:33.04,Default (Purble),ARISU,0,0,0,,‫لِمَ لا يمكنكِ فعل الشيء نفسه مع كلماتكِ؟
Dialogue: 0,0:15:33.04,0:15:38.71,Default (Purble),RIKKA,0,0,0,,‫أشعر أنه غش أن أستخدم الموسيقى\N‫للتعبير عما لم أستطع قوله مباشرة.
Dialogue: 0,0:15:38.71,0:15:43.34,Default (Purble),RIKKA,0,0,0,,‫إذا عبرتُ عن مشاعري بهذه الطريقة،\N‫فقد يخيب أملهم.
Dialogue: 0,0:15:44.30,0:15:49.97,Default (Purble),RIKKA,0,0,0,,‫أشعر أنهم سيرغبون في سماع ما\N‫يريدون سماعه حقًا مني مباشرة.
Dialogue: 0,0:15:49.97,0:15:50.81,Default (Purble),ARISU,0,0,0,,‫ريكا.
Dialogue: 0,0:15:50.81,0:15:51.60,Default (Purble),RIKKA,0,0,0,,‫ماذا؟
Dialogue: 0,0:15:51.60,0:15:52.64,Default (Purble),ARISU,0,0,0,,...يا لكِ
Dialogue: 0,0:15:52.64,0:15:54.18,Default (Purble),ARISU,0,0,0,,‫من فتاة طماعة!
Dialogue: 0,0:15:54.70,0:15:56.53,Default (Purble),ARISU,0,0,0,,‫أنتِ مباركة بموهبة!
Dialogue: 0,0:15:56.53,0:16:00.86,Default (Purble),ARISU,0,0,0,,‫يمكنكِ التعبير عن نفسكِ بطريقة لا\N‫يستطيعها معظم الناس! ما الذي يجعلك مترددة؟
Dialogue: 0,0:16:00.86,0:16:02.72,Default (Purble),ARISU,0,0,0,,‫لا يوجد تسلسل هرمي في التعبير عن الذات!
Dialogue: 0,0:16:02.72,0:16:07.07,Default (Purble),ARISU,0,0,0,,‫ليست الطريقة، بل قوة\N‫الشعور هي التي تحرك القلب.
Dialogue: 0,0:16:07.07,0:16:10.99,Default (Purble),ARISU,0,0,0,,‫عدم استخدام موهبة لديكِ يتعارض مع\N‫مبادئ عائلة يامابوكي!
Dialogue: 0,0:16:10.99,0:16:13.33,Default (Purble),RIKKA,0,0,0,,رغم أنني من عائلة إينوهانا؟
Dialogue: 0,0:16:13.79,0:16:14.79,Default (Purble),RIKKA,0,0,0,,...لنقل
Dialogue: 0,0:16:14.79,0:16:18.00,Default (Purble),RIKKA,0,0,0,,‫لنقل أن شخصًا ما استخدم أغنية\N‫للتعبير عن مشاعره لك.
Dialogue: 0,0:16:18.00,0:16:19.32,Default (Purble),RIKKA,0,0,0,,فهل ستكون سعيدًا؟
Dialogue: 0,0:16:20.99,0:16:22.02,Default (Purble),ARISU,0,0,0,,‫نعم.
Dialogue: 0,0:16:22.69,0:16:23.84,Default (Purble),ARISU,0,0,0,,.سأكون سعيدًا
Dialogue: 0,0:16:27.20,0:16:28.35,Default (Purble),RIKKA,0,0,0,,‫فهمت.
Dialogue: 0,0:16:31.28,0:16:34.38,Default (Purble),RIKKA,0,0,0,,‫إذن أظن أنني سأترك\N‫هذه الأغنية خارج القرص المضغوط.
Dialogue: 0,0:16:34.38,0:16:38.16,Default (Purble),ARISU,0,0,0,,‫ماذا؟ ظننتُ أنني تخلصتُ ‫من مخاوفكِ للتو!
Dialogue: 0,0:16:40.38,0:16:44.78,Default (Purble),RIKKA,0,0,0,,‫لأن هذه الأغنية الأخيرة تهدف\N‫إلى التعبير عن شيء عزيز جدًا عليّ.
Dialogue: 0,0:16:44.86,0:16:47.88,Default (Purble),RIKKA,0,0,0,,،‫بمجرد أن أستطيع أن أسمي نفسي فنانة
Dialogue: 0,0:16:47.88,0:16:52.37,Default (Purble),RIKKA,0,0,0,,‫وأشعر أن لدي الحق في استخدام\N‫الموسيقى كوسيلة للتعبير،
Dialogue: 0,0:16:52.37,0:16:54.83,Default (Purble),RIKKA,0,0,0,,‫عندها فقط سأطلقها إلى العالم.
Dialogue: 0,0:16:55.00,0:16:58.00,Default (Purble),ARISU,0,0,0,,‫هل ستحتفظين به ‫لحفل في بودوكان؟
Dialogue: 0,0:16:58.00,0:17:00.00,Default (Purble),RIKKA,0,0,0,,‫ليس شيئًا بهذا الحجم.
Dialogue: 0,0:17:00.21,0:17:03.56,Default (Purble),RIKKA,0,0,0,,‫إذا سار هذا العرض في الشارع على ما يرام
Dialogue: 0,0:17:03.56,0:17:06.92,Default (Purble),RIKKA,0,0,0,,‫وتمكنتُ من بيع 50 نسخة من قرصي المضغوط،
Dialogue: 0,0:17:08.44,0:17:09.78,Default (Purble),RIKKA,0,0,0,,‫فعندها...
Dialogue: 0,0:17:13.93,0:17:16.22,Default (Purble),RIKKA,0,0,0,,‫سأغنيها للشخص العزيز عليّ.
Dialogue: 0,0:17:20.30,0:17:22.27,Default (Purble),RIKKA,0,0,0,,‫سأقدم عرضي هنا؟
Dialogue: 0,0:17:22.27,0:17:25.79,Default (Purble),ARISU,0,0,0,,‫أجل، وتُعرف هذه الحديقة بأنها\N‫قِبلة عروض الشارع.
Dialogue: 0,0:17:25.79,0:17:29.65,Default (Purble),ARISU,0,0,0,,حسب ما سمعت، ‫فرقة "سيليستيال"، أحدث وأشهر ‫فرقة في الوقت الحالي،
Dialogue: 0,0:17:29.65,0:17:32.63,Default (Purble),ARISU,0,0,0,,‫كانت تقدم عروضها هنا ‫حتى العام الماضي أيضًا.
Dialogue: 0,0:17:32.63,0:17:36.00,Default (Purble),ARISU,0,0,0,,‫وبهذا، سيكون لدى الجمهور ‫معايير عالية جدًا.
Dialogue: 0,0:17:36.00,0:17:40.14,Default (Purble),ARISU,0,0,0,,‫لكن إذا تمكنتِ من كسب معجبين هنا،\N‫فستصنعين اسمًا لنفسكِ حتمًا.
Dialogue: 0,0:17:42.96,0:17:45.15,Default (Purble),ARISU,0,0,0,,‫صنعتُ منشورات ووزعتها.
Dialogue: 0,0:17:45.15,0:17:48.59,Default (Purble),ARISU,0,0,0,,‫تحتاجين إلى ترك انطباع أول جيد ‫لكسب الجمهور.
Dialogue: 0,0:17:48.59,0:17:52.96,Default (Purble),ARISU,0,0,0,,‫حجزتُ لكِ مكانًا ‫به مساحة ورؤية واضحة.
Dialogue: 0,0:17:53.44,0:17:55.84,Default (Purble),RIKKA,0,0,0,,‫أشعر بألم حاد في صدري.
Dialogue: 0,0:17:55.84,0:18:01.11,Default (Purble),RIKKA,0,0,0,,‫هذا يعيد الذكريات.\N‫كنتُ متوترة في المرة الأولى أيضًا.
Dialogue: 0,0:18:01.11,0:18:02.10,Default (Purble),RIKKA,0,0,0,,...لكنه
Dialogue: 0,0:18:02.10,0:18:04.31,Default (Purble),RIKKA,0,0,0,,.ليس نفس الألم الذي شعرتُ بها آنذاك...
Dialogue: 0,0:18:04.31,0:18:08.20,Default (Purble),RIKKA,0,0,0,,‫في ذلك الوقت، لم أكن أعرف شيئًا\N‫وكنتُ مليئة بالأمل الساذج،
Dialogue: 0,0:18:08.20,0:18:10.36,Default (Purble),RIKKA,0,0,0,,‫لكنني الآن خائفة وحسب.
Dialogue: 0,0:18:10.92,0:18:13.55,Default (Purble),RIKKA,0,0,0,,‫خائفة من أن ينظروا إليّ ‫بتلك العيون مرة أخرى.
Dialogue: 0,0:18:13.55,0:18:14.78,Default (Purble),RIKKA,0,0,0,,‫ماذا الآن؟
Dialogue: 0,0:18:14.78,0:18:16.58,Default (Purble),RIKKA,0,0,0,,‫ربما لا أستطيع فعل هذا.
Dialogue: 0,0:18:16.58,0:18:19.45,Default (Purble),RIKKA,0,0,0,,‫ربما يجب أن ألغيه، ‫أو شيء من هذا القبيل...
Dialogue: 0,0:18:19.45,0:18:20.53,Default (Purble),ARISU,0,0,0,,‫ريكا.
Dialogue: 0,0:18:20.85,0:18:22.08,Default (Purble),RIKKA,0,0,0,,‫مـ-ماذا؟
Dialogue: 0,0:18:22.08,0:18:24.29,Default (Purble),ARISU,0,0,0,,إذن؟ ‫هل تجدين عينيّ مخيفتين؟
Dialogue: 0,0:18:24.29,0:18:25.85,Default (Purble),RIKKA,0,0,0,,‫لـ-ليس حقًا.
Dialogue: 0,0:18:25.85,0:18:27.21,Default (Purble),ARISU,0,0,0,,جميلتان، أليس كذلك؟
Dialogue: 0,0:18:27.21,0:18:28.77,Default (Purble),RIKKA,0,0,0,,.هذا ليس ما قلتُه
Dialogue: 0,0:18:30.26,0:18:31.63,Default (Purble),ARISU,0,0,0,,‫اسمعي يا ريكا.
Dialogue: 0,0:18:31.63,0:18:35.97,Default (Purble),ARISU,0,0,0,,‫إذا واجهتِ وقتًا عصيبًا أثناء\N‫العرض ولم تتمكني من رفع رأسكِ،
Dialogue: 0,0:18:35.97,0:18:37.64,Default (Purble),ARISU,0,0,0,,‫فقط انظري في عينيّ.
Dialogue: 0,0:18:37.64,0:18:39.27,Default (Purble),RIKKA,0,0,0,,‫حـ-حسنٌ.
Dialogue: 0,0:18:39.27,0:18:40.21,Default (Purble),ARISU,0,0,0,,‫عظيم.
Dialogue: 0,0:18:40.21,0:18:42.44,Default (Purble),ARISU,0,0,0,,‫من الجيد أنني أتيتُ مستعدًا.
Dialogue: 0,0:18:43.37,0:18:46.69,Default (Purble),ARISU,0,0,0,,‫حتى لو فقدتِ أثري ‫بين حشد المتفرجين،
Dialogue: 0,0:18:46.69,0:18:48.78,Default (Purble),ARISU,0,0,0,,‫فستتمكنين من رؤيتي ألوح بهاتين!
Dialogue: 0,0:18:48.78,0:18:51.10,Default (Purble),RIKKA,0,0,0,,‫سأموت من الإحراج، لذا لا تجرؤ على فعل ذلك.
Dialogue: 0,0:18:51.10,0:18:54.54,Default (Purble),ARISU,0,0,0,,‫ماذا؟ أتستخدمين كلمة "محرج"\N‫لوصفي أنا؛ يامابوكي العظيم؟
Dialogue: 0,0:18:57.15,0:19:00.30,Default (Purble),RIKKA,0,0,0,,‫أنتَ تساعدني على الاسترخاء، أليس كذلك؟ شكرًا.
Dialogue: 0,0:19:00.30,0:19:02.46,Default (Purble),RIKKA,0,0,0,,.سأبذل كل ما لدي
Dialogue: 0,0:19:04.32,0:19:06.32,Default (Purble),ARISU,0,0,0,,‫أجل، ابذلي قصارى جهدكِ.
Dialogue: 0,0:19:06.92,0:19:08.93,Default (Purble),ARISU,0,0,0,,‫سنراقبكِ طوال الوقت.
Dialogue: 0,0:19:23.56,0:19:26.66,Default (Purble) - Top,RIKKA,0,0,0,,إذن، ‫إليكم أغنيتي الأولى، ‫"أيام وامضة".
Dialogue: 0,0:19:41.92,0:19:46.31,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫بينما نظرنا إلى السماء الزرقاء المفتوحة
Dialogue: 0,0:19:43.55,0:19:46.31,Default (Purble),GIRL,0,0,0,,‫ماذا... تريد أن تفعل الآن؟
Dialogue: 0,0:19:46.31,0:19:49.65,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫بأحرف بيضاء ناصعة
Dialogue: 0,0:19:49.65,0:19:54.05,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫كتبنا عن هدفنا، ‫كتبنا عن مستقبلنا
Dialogue: 0,0:19:54.05,0:19:57.65,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫ولوناه بأحلامنا
Dialogue: 0,0:19:57.95,0:20:03.27,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫مع كل "أراك غدًا"
Dialogue: 0,0:19:59.07,0:20:02.85,Default (Purble),ARISU,0,0,0,,.بالكاد صوتها مسموع ويفتقر إلى الإيقاع
Dialogue: 0,0:20:02.85,0:20:05.57,Default (Purble),ARISU,0,0,0,,‫أظن أنه ليس من السهل ‫التخلص من قلقها.
Dialogue: 0,0:20:03.27,0:20:05.87,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫قلوبنا اقتربت أكثر
Dialogue: 0,0:20:05.87,0:20:10.26,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫بينما نمر بأوقات جيدة وسيئة
Dialogue: 0,0:20:07.34,0:20:11.30,Default (Purble),ARISU,0,0,0,,‫مع عدم وجود جمهور،\N‫ستزداد حالتها النفسية سوءًا.
Dialogue: 0,0:20:10.26,0:20:15.09,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫نسير بخطوات مرتبكة
Dialogue: 0,0:20:12.58,0:20:15.09,Default (Purble),ARISU,0,0,0,,‫عليكِ أن تبقي هادئة يا ريكا.
Dialogue: 0,0:20:16.36,0:20:20.51,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫نمسك أيدينا بإحكام،\N‫وكلماتنا تصل إلى بعضها البعض
Dialogue: 0,0:20:16.36,0:20:18.37,Default (Purble),RIKKA,0,0,0,,‫كنتُ أعلم أن الأمر لن ينجح.
Dialogue: 0,0:20:18.80,0:20:20.51,Default (Purble),RIKKA,0,0,0,,‫لا أحد يتوقف.
Dialogue: 0,0:20:20.51,0:20:23.44,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫وتدفعنا بلطف إلى الأمام
Dialogue: 0,0:20:21.18,0:20:24.58,Default (Purble),RIKKA,0,0,0,,‫لا أحد يستمع إلى... أغنيتي.
Dialogue: 0,0:20:23.44,0:20:26.38,Narration OP 2 (Mayonka),RIKKA,0,0,0,,{\fad(250,250)\be3\fs100}‫صندوق البريد الدائري، ممر المشاة المعتاد
Dialogue: 0,0:20:25.68,0:20:28.42,Default (Blue),PRODUCER,0,0,0,,‫ظننتُ أنكِ ستكونين على قدر المسؤولية.
