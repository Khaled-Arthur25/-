Dialogue: 0,0:00:34.97,0:00:39.30,Main,NTP,0,0,0,,‫أخذتما أيرا مني.
Dialogue: 0,0:00:39.60,0:00:42.60,Main,NTP,0,0,0,,‫صغيرتي أيرا!
Dialogue: 0,0:00:49.98,0:00:54.15,Main,NTP,0,0,0,,‫أعيداها ‫أيها الخنزيران القذران.
Dialogue: 0,0:00:56.49,0:00:59.20,Main,NTP,0,0,0,,‫أيرا-تشان تعوق طريقنا، ‫يا للإحباط!
Dialogue: 0,0:00:59.49,0:01:00.78,Main,NTP,0,0,0,,‫ما العمل يا مومو-تشان؟
Dialogue: 0,0:01:00.87,0:01:02.27,Main,NTP,0,0,0,,‫لنواصل الهرب فحسب.
Dialogue: 0,0:01:06.54,0:01:09.50,Main,NTP,0,0,0,,‫يعج هذا المكان بالعوائق، ‫ولا أستطيع الجري سريعًا.
Dialogue: 0,0:01:09.67,0:01:11.88,Main,NTP,0,0,0,,‫لا بأس، لديّ فكرة.
Dialogue: 0,0:01:11.88,0:01:13.50,Main,NTP,0,0,0,,‫لن أدعكِ تهربين.
Dialogue: 0,0:01:13.92,0:01:16.01,Main,NTP,0,0,0,,‫أيتها الفتاة الجانحة!
Dialogue: 0,0:01:17.00,0:01:17.80,Main,NTP,0,0,0,,‫مومو-تشان!
Dialogue: 0,0:01:22.76,0:01:24.26,Main,NTP,0,0,0,,‫أعِد أيرا!
Dialogue: 0,0:01:24.31,0:01:26.56,Main,NTP,0,0,0,,‫أيها الغر الأحمق التافه!
Dialogue: 0,0:01:27.14,0:01:28.44,Main,NTP,0,0,0,,!كم هذا محبط
Dialogue: 0,0:01:44.04,0:01:46.70,Main,NTP,0,0,0,,‫في هذا المكان المليء بالعقبات...
Dialogue: 0,0:01:51.25,0:01:55.05,Main,NTP,0,0,0,,‫أتظن أن بإمكانكَ الفرار من حركاتي البهلوانية؟
Dialogue: 0,0:01:55.67,0:01:57.30,Main,NTP,0,0,0,,‫محالٌ أن تفلح في ذلك!
Dialogue: 0,0:01:59.34,0:02:01.09,Main,NTP,0,0,0,,‫لا بأس يا أيرا.
Dialogue: 0,0:02:01.09,0:02:03.85,Main,NTP,0,0,0,,‫إن كنتِ تكرهين مناداتي ‫بـ"أمي" إلى هذا الحد،
Dialogue: 0,0:02:04.14,0:02:06.00,Main,NTP,0,0,0,,‫فلا بأس عندي بذلك.
Dialogue: 0,0:02:08.69,0:02:11.40,Main,NTP,0,0,0,,‫دعيني أبقى معكِ فحسب...
Dialogue: 0,0:02:12.27,0:02:15.94,Main,NTP,0,0,0,,‫إن التهمتكِ، ‫فستغدين جزءًا من لحمي ودمي،
Dialogue: 0,0:02:15.94,0:02:18.74,Main,NTP,0,0,0,,‫وحينها سنبقى معًا إلى الأبد!
Dialogue: 0,0:02:19.07,0:02:21.53,Main,NTP,0,0,0,,‫لذا دعيني أُحسن...
Dialogue: 0,0:02:22.78,0:02:25.50,Main,NTP,0,0,0,,‫مضغكِ.
Dialogue: 0,0:02:26.66,0:02:29.21,Main,NTP,0,0,0,,‫ما هذا؟ ما الذي يحدث؟
Dialogue: 0,0:02:29.58,0:02:32.08,Main,NTP,0,0,0,,‫لِمَ أعجز عن التقدم إلى الأمام؟!
Dialogue: 0,0:02:32.21,0:02:36.01,Main,NTP,0,0,0,,‫تلتف حركاتكِ البهلوانية حول كل شيءٍ وتجرفه، أليس كذلك؟
Dialogue: 0,0:02:36.17,0:02:38.77,Main,NTP,0,0,0,,‫بتسريحة العجائز الغبية تلك،
Dialogue: 0,0:02:39.38,0:02:42.78,Main,NTP,0,0,0,,‫يبدو أنكِ تعجزين عن فكّ ‫ما علق به.
Dialogue: 0,0:02:45.39,0:02:46.56,Main,NTP,0,0,0,,‫أحسنتَ يا أوكارون.
Dialogue: 0,0:02:46.56,0:02:48.35,Main,NTP,0,0,0,,‫راوغتَ وهربتَ ببراعةٍ حقًا.
Dialogue: 0,0:02:48.73,0:02:50.77,Main,NTP,0,0,0,,‫أيها الخنزيران اللعينان...
Dialogue: 0,0:02:50.94,0:02:55.57,Main,NTP,0,0,0,,‫إياكما والظن ‫أنكما أسرتماني بحيلةٍ كهذه.
Dialogue: 0,0:03:00.61,0:03:04.03,Main,NTP,0,0,0,,‫إنها تحاول تحطيم الأعمدة ‫كي تفلت يا أياسي-سان.
Dialogue: 0,0:03:04.03,0:03:05.07,Main,NTP,0,0,0,,‫لن أسمح لكِ.
Dialogue: 0,0:03:08.49,0:03:13.64,Main,NTP,0,0,0,,‫إياكِ ولمس ساقيّ الجميلتين ‫أيتها الفتاة الجانحة اللعينة.
Dialogue: 0,0:03:13.71,0:03:15.31,Main,NTP,0,0,0,,‫انطلق بأقصى سرعة يا أوكارون.
Dialogue: 0,0:03:15.50,0:03:16.75,Main,NTP,0,0,0,,‫لم تستخدمها بعد، أليس كذلك؟
Dialogue: 0,0:03:16.92,0:03:18.80,Main,NTP,0,0,0,,‫انطلق بأقصى سرعةٍ ‫وأطِح بها!
Dialogue: 0,0:03:22.93,0:03:25.03,Main,NTP,0,0,0,,‫أُطيح بها؟ وكيف أفعل ذلك؟!
Dialogue: 0,0:03:26.01,0:03:29.51,Main,NTP,0,0,0,,‫حين قاتلنا الفضائي،\N‫فقدتُ صوابي ورحتُ أعضّه بيأس،
Dialogue: 0,0:03:29.68,0:03:32.50,Main,NTP,0,0,0,,‫وعند مواجهة الروح المقيدة،\N‫كرّستُ كل جهدي للهرب فحسب.
Dialogue: 0,0:03:32.85,0:03:35.06,Main,NTP,0,0,0,,‫لم يسبق لي أن هزمتُ أحدًا قط.
Dialogue: 0,0:03:35.06,0:03:38.20,Main,NTP,0,0,0,,‫ما هذا الكلام الآن؟ ‫اركلها وأطِح بها فحسب!
Dialogue: 0,0:03:38.20,0:03:40.24,Main,NTP,0,0,0,,‫أركلها؟ كما في كرة القدم؟
Dialogue: 0,0:03:40.24,0:03:42.74,Main,NTP,0,0,0,,‫وما أدراني، ‫لا يهم كيف، أسرع وافعلها!
Dialogue: 0,0:03:48.62,0:03:50.41,Main,NTP,0,0,0,,‫الوضع سيئ! أسرع يا أوكارون!
Dialogue: 0,0:03:50.41,0:03:51.61,Main,NTP,0,0,0,,‫لم أعد أقدر على كبحها!
Dialogue: 0,0:03:51.79,0:03:54.00,Main,NTP,0,0,0,,‫أيها الصعلوكان...
Dialogue: 0,0:03:54.58,0:03:58.26,Main,NTP,0,0,0,,‫سأقتلكما شرّ قتلة!
Dialogue: 0,0:03:59.71,0:04:02.71,Main,NTP,0,0,0,,.اهزمها يا أوكارون
Dialogue: 0,0:04:19.40,0:04:20.20,Main,NTP,0,0,0,,!يا إلهي
Dialogue: 0,0:04:21.36,0:04:22.51,Main,NTP,0,0,0,,‫ما هذا؟!
Dialogue: 0,0:04:22.99,0:04:26.00,Main,NTP,0,0,0,,‫هذا مذهل حقًا، ‫لستَ سيئًا عندما تحاول يا أوكارون.
Dialogue: 0,0:04:25.66,0:04:27.16,Top,NTP,0,0,0,,‫مؤلم!
Dialogue: 0,0:04:27.16,0:04:29.46,Main,NTP,0,0,0,,‫سينفجر جسدي بالكامل.
Dialogue: 0,0:04:31.74,0:04:35.74,Main,NTP,0,0,0,,‫استخدمتَ قوتي! ومع ذلك، أهذا كان كل ما لديك؟
Dialogue: 0,0:04:38.00,0:04:39.34,Main,NTP,0,0,0,,.هذا مؤلم جدًا
Dialogue: 0,0:04:39.50,0:04:40.97,Main,NTP,0,0,0,,‫أيها الوغد اللعين!
Dialogue: 0,0:04:41.30,0:04:42.55,Main,NTP,0,0,0,,‫ما العمل معها الآن؟
Dialogue: 0,0:04:42.76,0:04:44.36,Main,NTP,0,0,0,,‫أنطلب من جدتي تطهيرها؟
Dialogue: 0,0:04:44.67,0:04:46.31,Main,NTP,0,0,0,,‫دعي نكرةً كهذه وشأنها.
Dialogue: 0,0:04:46.65,0:04:48.50,Main,NTP,0,0,0,,‫فقد تلقّتْ إحدى هجماتي للتو،
Dialogue: 0,0:04:48.72,0:04:51.02,Main,NTP,0,0,0,,‫ولن تقوى على استخدام ‫طاقتها الروحية لفترة.
Dialogue: 0,0:04:51.26,0:04:52.56,Main,NTP,0,0,0,,‫الأهم من ذلك، الكرة الذهبية.
Dialogue: 0,0:04:52.56,0:04:54.30,Main,NTP,0,0,0,,‫إنها بحوزة تلك الفتاة، أليس كذلك؟
Dialogue: 0,0:04:54.94,0:04:55.64,Main,NTP,0,0,0,,!صحيح
Dialogue: 0,0:04:55.85,0:04:57.44,Main,NTP,0,0,0,,‫لنستعدها ما دامت الفرصة سانحة.
Dialogue: 0,0:05:00.02,0:05:03.35,Main,NTP,0,0,0,,‫بل أود فكّ هذا الرباط البلاستيكي ‫عن معصميّ أولًا.
Dialogue: 0,0:05:03.35,0:05:04.83,Main,NTP,0,0,0,,‫أمعكَ مقصّ يا أوكارون؟
Dialogue: 0,0:05:06.07,0:05:08.27,Main,NTP,0,0,0,,‫أعتذر، ليس معي.
Dialogue: 0,0:05:08.82,0:05:12.08,Main,NTP,0,0,0,,‫ظللتُ مقيدةً طوال هذا الوقت\N‫بسبب هذه الفتاة البلهاء.
Dialogue: 0,0:05:12.08,0:05:14.75,Note,NTP,0,0,0,,إحدى الأساطير الحضرية اليابانية الحديثة، تشتهر هذه الأسطورة بقصة\Nشبح امرأة طويلة القامة ذات شعر أسود طويل وحريري، ترتدي ملابس حمراء وتؤدي\Nحركات بهلوانية فوق أسطح المباني المرتفعة
Dialogue: 0,0:05:12.08,0:05:14.75,Main,NTP,0,0,0,,‫ما علاقتها بأكرو-سيلكي ‫على أي حال؟
Dialogue: 0,0:05:14.83,0:05:16.08,Main,NTP,0,0,0,,‫يا مومو...
Dialogue: 0,0:05:16.80,0:05:17.83,Main,NTP,0,0,0,,‫أوجدتِ الكرة الذهبية؟
Dialogue: 0,0:05:18.12,0:05:19.12,Main,NTP,0,0,0,,‫وجدتُها.
Dialogue: 0,0:05:20.08,0:05:21.67,Main,NTP,0,0,0,,‫هذا خبرٌ سارّ يا أوكارون!
Dialogue: 0,0:05:21.67,0:05:23.13,Main,NTP,0,0,0,,‫وجدنا إحدى خصيتيك!
Dialogue: 0,0:05:23.13,0:05:24.71,Main,NTP,0,0,0,,‫أسلوبكِ في قولها محرجٌ للغاية.
Dialogue: 0,0:05:24.71,0:05:26.67,Main,NTP,0,0,0,,‫الأهم من هذا...
Dialogue: 0,0:05:27.51,0:05:28.30,Main,NTP,0,0,0,,‫ما الخطب؟
Dialogue: 0,0:05:30.51,0:05:32.81,Main,NTP,0,0,0,,‫هذه الفتاة ميتة.
Dialogue: 0,0:07:05.27,0:07:06.44,Main,NTP,0,0,0,,‫ميتة؟
Dialogue: 0,0:07:06.65,0:07:07.57,Main,NTP,0,0,0,,‫محال!
Dialogue: 0,0:07:07.57,0:07:08.78,Main,NTP,0,0,0,,‫تفقّد نبضها يا أوكارون!
Dialogue: 0,0:07:08.78,0:07:09.60,Main,NTP,0,0,0,,‫حـ-حاضر!
Dialogue: 0,0:07:17.62,0:07:18.62,Main,NTP,0,0,0,,‫مستحيل...
Dialogue: 0,0:07:18.87,0:07:22.60,Main,NTP,0,0,0,,‫يموت أي بشري عادي ‫إذا التهمه يوكاي.
Dialogue: 0,0:07:23.00,0:07:25.34,Main,NTP,0,0,0,,‫وليس في الأمر ما يدعو للذعر.
Dialogue: 0,0:07:25.42,0:07:27.80,Main,NTP,0,0,0,,‫نجا من الموت بمحض المصادفة\N‫من تملك قوى خارقة،
Dialogue: 0,0:07:27.80,0:07:30.47,Main,NTP,0,0,0,,‫ومن يحمل طاقتي الروحية ‫في جسده.
Dialogue: 0,0:07:30.47,0:07:32.01,Main,NTP,0,0,0,,‫هذا كل ما في الأمر.
Dialogue: 0,0:07:32.01,0:07:33.72,Main,NTP,0,0,0,,‫أتجيد التنفس الصناعي يا أوكارون؟
Dialogue: 0,0:07:34.06,0:07:35.51,Main,NTP,0,0,0,,‫لـ-لستُ واثقًا من قدرتي.
Dialogue: 0,0:07:35.51,0:07:37.26,Main,NTP,0,0,0,,‫سأجرب تدليك القلب!
Dialogue: 0,0:07:37.47,0:07:40.30,Main,NTP,0,0,0,,‫إن استخدمتُ قواي الخارقة\N‫فبإمكاني تدليك قلبها مباشرة!
Dialogue: 0,0:07:47.40,0:07:51.10,Main,NTP,0,0,0,,‫إن ماتت فالقلب ليس سوى ‫قطعة لحمٍ هامدة.
Dialogue: 0,0:07:47.77,0:07:50.69,Top,NTP,0,0,0,,‫واحد، اثنان، ثلاثة، أربعة، خمسة...
Dialogue: 0,0:07:51.24,0:07:52.78,Main,NTP,0,0,0,,‫لا جدوى من تدليكه إطلاقًا.
Dialogue: 0,0:07:52.78,0:07:53.57,Main,NTP,0,0,0,,‫اخرسي!
Dialogue: 0,0:07:53.57,0:07:55.27,Main,NTP,0,0,0,,‫إن كنتِ ستعوقيننا ‫فاغربي عن وجهنا!
Dialogue: 0,0:07:55.74,0:07:56.70,Main,NTP,0,0,0,,‫تولَّ التنفس يا أوكارون!
Dialogue: 0,0:07:56.83,0:07:58.16,Main,NTP,0,0,0,,‫هـ-ها أنا ذا!
Dialogue: 0,0:07:59.37,0:08:02.41,Main,NTP,0,0,0,,‫اتصلي بالإسعاف أيتها العجوز!\N‫أليس معكِ هاتف موكو؟
Dialogue: 0,0:08:02.66,0:08:04.30,Main,NTP,0,0,0,,!يا للعبث
Dialogue: 0,0:08:08.21,0:08:09.09,Main,NTP,0,0,0,,‫مرةً أخرى!
Dialogue: 0,0:08:09.09,0:08:11.72,Main,NTP,0,0,0,,‫واحد، اثنان، ثلاثة، أربعة، خمسة...
Dialogue: 0,0:08:11.90,0:08:12.70,Main,NTP,0,0,0,,‫أوكارون!
Dialogue: 0,0:08:15.18,0:08:17.98,Main,NTP,0,0,0,,‫واحد، اثنان، ثلاثة، أربعة، خمسة...
Dialogue: 0,0:08:19.47,0:08:21.30,Main,NTP,0,0,0,,‫أيرا...
Dialogue: 0,0:08:21.93,0:08:24.33,Main,NTP,0,0,0,,‫صغيرتي أيرا...
Dialogue: 0,0:08:24.73,0:08:26.90,Main,NTP,0,0,0,,‫أنتِ! ‫لا وقت لدينا لهذا الآن!
Dialogue: 0,0:08:26.90,0:08:30.19,Main,NTP,0,0,0,,‫سأتكفل بها أناK\N‫واصلي إنعاشها يا أياسي-سان!
Dialogue: 0,0:08:30.40,0:08:33.40,Main,NTP,0,0,0,,‫لن تعود أيرا إلى الحياة هكذا.
Dialogue: 0,0:08:33.74,0:08:35.84,Main,NTP,0,0,0,,‫ثمة طريقةٌ أنجع من ذلك.
Dialogue: 0,0:08:36.20,0:08:38.46,Main,NTP,0,0,0,,‫امنحي هالتي لأيرا.
Dialogue: 0,0:08:38.95,0:08:42.25,Main,NTP,0,0,0,,‫فالهالة للكائنات الحية كالبطارية.
Dialogue: 0,0:08:42.91,0:08:45.61,Main,NTP,0,0,0,,‫لا تتحرك المحركات من دون بطاريات، أليس كذلك؟
Dialogue: 0,0:08:46.37,0:08:50.88,Main,NTP,0,0,0,,‫هالة أيرا على وشك التلاشي،\N‫لذا بإمكانكِ تعويضها بهالتي.
Dialogue: 0,0:08:50.88,0:08:53.34,Main,NTP,0,0,0,,‫ومن سيصدق كلامكِ هذا؟!
Dialogue: 0,0:08:53.34,0:08:55.63,Main,NTP,0,0,0,,‫تنوين التهامها مجددًا\N‫على كل حال، أليس كذلك؟!
Dialogue: 0,0:09:01.10,0:09:03.10,Main,NTP,0,0,0,,.هكذا لن أستطيع التهام أحدٍ الآن
Dialogue: 0,0:09:03.52,0:09:08.92,Main,NTP,0,0,0,,‫إن كنتِ لا تثقين بي بعد\N‫فاسحقي رأسي بهذه العارضة الفولاذية.
Dialogue: 0,0:09:10.65,0:09:13.05,Main,NTP,0,0,0,,‫ما تقوله صادقٌ تمامًا.
Dialogue: 0,0:09:14.11,0:09:17.66,Main,NTP,0,0,0,,‫من دون هالة،\N‫ستظل تلك الفتاة على حالها ذاك.
Dialogue: 0,0:09:23.29,0:09:25.33,Main,NTP,0,0,0,,‫لا أثق بكِ أبدًا!
Dialogue: 0,0:09:25.33,0:09:28.83,Main,NTP,0,0,0,,لذا ‫إن بدرت منكِ أدنى حركةٍ مريبة\N‫فسأسحق رأسكِ في الحال!
Dialogue: 0,0:09:29.38,0:09:31.58,Main,NTP,0,0,0,,‫بإمكانك الانطلاق بأقصى سرعةٍ\N‫مرةً أخرى يا أوكارون، أليس كذلك؟
Dialogue: 0,0:09:33.76,0:09:35.36,Main,NTP,0,0,0,,‫أبقِها تحت مرمى نظرك.
Dialogue: 0,0:09:36.72,0:09:40.60,Main,NTP,0,0,0,,‫قلتِ إنكِ ستعوضين هالة هذه\N‫الفتاة البلهاء بهالتكِ، أليس كذلك؟
Dialogue: 0,0:09:41.39,0:09:43.39,Main,NTP,0,0,0,,‫كيف أفعل ذلك؟ أخبريني بالطريقة!
Dialogue: 0,0:09:44.93,0:09:50.70,Main,NTP,0,0,0,,‫صِلي هالتي بهالة أيرا الخافتة\N‫باستخدام قواكِ الخارقة.
Dialogue: 0,0:09:51.23,0:09:53.83,Main,NTP,0,0,0,,‫الأمر أشبه بكابل ‫توصيل.
Dialogue: 0,0:09:58.11,0:10:00.11,Main,NTP,0,0,0,,‫راقبها جيدًا ‫يا أوكارون.
Dialogue: 0,0:10:00.53,0:10:01.22,Main,NTP,0,0,0,,‫يا للإزعاج.
Dialogue: 0,0:10:02.12,0:10:02.92,Main,NTP,0,0,0,,‫ها أنا ذي!
Dialogue: 0,0:10:42.91,0:10:44.91,Main (Blue),NTP,0,0,0,,‫هيا نذهب إلى الكاراوكي.
Dialogue: 0,0:10:45.58,0:10:47.45,Main (Blue),NTP,0,0,0,,‫محالٌ أن نذهب.
Dialogue: 0,0:11:46.01,0:11:46.98,Main (Blue),NTP,0,0,0,,‫عدتُ.
Dialogue: 0,0:14:26.17,0:14:27.97,Main (Blue),NTP,0,0,0,,‫لا تستخفّي بنا، سحقًا!
Dialogue: 0,0:14:34.47,0:14:35.67,Main (Blue),NTP,0,0,0,,‫أيتها الحقيرة!
Dialogue: 0,0:14:40.57,0:14:41.40,Main (Blue),NTP,0,0,0,,!تبًا
Dialogue: 0,0:16:51.94,0:16:55.44,Main (Blue),NTP,0,0,0,,‫شكرًا لكِ على كل ما تفعلينه دائمًا يا أمي.
Dialogue: 0,0:17:00.45,0:17:02.20,Main (Blue),NTP,0,0,0,,‫لا أستطيع التذكر.
Dialogue: 0,0:17:04.33,0:17:08.73,Main (Blue),NTP,0,0,0,,‫أشعر بأنني فقدتُ شيئًا عزيزًا عليّ.
Dialogue: 0,0:17:12.51,0:17:13.51,Main (Blue),NTP,0,0,0,,‫أمي.
Dialogue: 0,0:17:21.01,0:17:21.71,Main (Blue),NTP,0,0,0,,‫ماذا؟
Dialogue: 0,0:17:22.56,0:17:23.56,Main (Blue),NTP,0,0,0,,‫لستِ هي...
Dialogue: 0,0:17:23.81,0:17:24.50,Main (Blue),NTP,0,0,0,,‫أيرا!
Dialogue: 0,0:17:32.30,0:17:34.52,Main (Blue),NTP,0,0,0,,‫ألم أقل لكِ ألا تركضي ‫بعيدًا بمفردكِ؟
Dialogue: 0,0:17:35.53,0:17:37.93,Main (Blue),NTP,0,0,0,,‫ظننتُ أن أمي هناك.
Dialogue: 0,0:17:38.84,0:17:41.24,Main,NTP,0,0,0,,‫محالٌ أن تكون في مكانٍ كهذا.
Dialogue: 0,0:17:42.12,0:17:45.16,Main (Blue),NTP,0,0,0,,‫أين ذهبت أمي يا أبي؟
Dialogue: 0,0:17:45.54,0:17:47.04,Main (Blue),NTP,0,0,0,,‫أخبرتكِ مرارًا من قبل.
Dialogue: 0,0:17:47.54,0:17:49.74,Main (Blue),NTP,0,0,0,,‫ذهبتْ إلى مكانٍ بعيدٍ للغاية.
Dialogue: 0,0:17:50.54,0:17:52.04,Main (Blue),NTP,0,0,0,,‫متى ستعود؟
Dialogue: 0,0:17:52.92,0:17:56.12,Main (Blue),NTP,0,0,0,,‫لن تعود لفترةٍ طويلة.
Dialogue: 0,0:17:56.72,0:17:58.72,Main (Blue),NTP,0,0,0,,‫لذا يجب أن تغدي أقوى يا أيرا.
Dialogue: 0,0:17:59.47,0:18:02.10,Main (Blue),NTP,0,0,0,,‫لتتمكني من تدبر أموركِ\N‫بمفردكِ حتى في غياب أمكِ،
Dialogue: 0,0:18:03.14,0:18:06.64,Main (Blue),NTP,0,0,0,,‫كي تفخر بكِ ‫حين تعود.
Dialogue: 0,0:18:08.28,0:18:10.90,Main (Blue),NTP,0,0,0,,‫ستغدو أيرا فتاةً ‫تفخر بها أمها.
Dialogue: 0,0:18:15.19,0:18:16.19,Main (Blue),NTP,0,0,0,,‫طفلتي...
Dialogue: 0,0:18:17.28,0:18:19.54,Main (Blue),NTP,0,0,0,,أين طفلتي؟
Dialogue: 0,0:18:23.91,0:18:24.70,Main (Blue),NTP,0,0,0,,‫أيرا...
Dialogue: 0,0:18:27.25,0:18:30.25,Main (Blue),NTP,0,0,0,,‫أجل، ‫تذكرتُ الآن...
Dialogue: 0,0:18:30.83,0:18:32.29,Main (Blue),NTP,0,0,0,,‫كنتُ...
Dialogue: 0,0:18:32.50,0:18:34.00,Main (Blue),NTP,0,0,0,,‫أمّ أيرا.
Dialogue: 0,0:18:37.09,0:18:39.09,Main (Blue),NTP,0,0,0,,‫سأحميها أنا.
Dialogue: 0,0:18:39.72,0:18:42.82,Main (Blue),NTP,0,0,0,,‫كي لا يؤذيها أحد...
Dialogue: 0,0:18:43.81,0:18:45.11,Main (Blue),NTP,0,0,0,,--سوف
Dialogue: 0,0:18:47.98,0:18:48.98,Main,NTP,0,0,0,,‫عادت إلى الحياة!
Dialogue: 0,0:18:49.98,0:18:52.48,Main,NTP,0,0,0,,‫ما خطبكِ يا مومو-تشان؟ ‫أفعلت بكِ شيئًا؟
Dialogue: 0,0:18:53.11,0:18:55.71,Main,NTP,0,0,0,,‫بإمكاني القضاء عليها\N‫إن بدرت منها أي حركةٍ مريبة، أليس كذلك؟
Dialogue: 0,0:18:56.48,0:18:57.88,Main,NTP,0,0,0,,‫سأنطلق بأقصى سرعة.
Dialogue: 0,0:18:58.11,0:18:58.81,Main,NTP,0,0,0,,‫انتظر!
Dialogue: 0,0:19:01.41,0:19:03.81,Main,NTP,0,0,0,,‫توقف... أرجوك...
Dialogue: 0,0:19:06.95,0:19:08.95,Main,NTP,0,0,0,,‫آسفة يا أيرا...
Dialogue: 0,0:19:09.54,0:19:11.74,Main,NTP,0,0,0,,‫أقسمتُ أنني سأحميكِ...
Dialogue: 0,0:19:12.21,0:19:14.71,Main,NTP,0,0,0,,‫ومع ذلك، لم أفعل شيئًا سوى إيذائكِ.
Dialogue: 0,0:19:17.17,0:19:20.87,Main,NTP,0,0,0,,‫أعجز حتى عن السيطرة على مشاعري.
Dialogue: 0,0:19:21.18,0:19:23.58,Main,NTP,0,0,0,,‫غدوتُ مجرد وحش.
Dialogue: 0,0:19:24.97,0:19:27.70,Main,NTP,0,0,0,,‫لذا سأنهي كل شيءٍ الآن.
Dialogue: 0,0:19:29.85,0:19:33.25,Main,NTP,0,0,0,,‫مهلًا! إنها تتلاشى شيئًا فشيئًا، ‫ما الذي سيحل بها؟
Dialogue: 0,0:19:33.52,0:19:37.52,Main,NTP,0,0,0,,‫أخبرتكِ سلفًا، الهالة كالبطارية، ‫إن نفدت فالهلاك حتمي.
Dialogue: 0,0:19:38.07,0:19:42.67,Main,NTP,0,0,0,,‫وفوق ذلك، ما زالت مثقلةً بالندم، ‫لذا لن ترقد بسلام.
Dialogue: 0,0:19:42.99,0:19:44.28,Main,NTP,0,0,0,,‫وماذا سيحدث إذن؟
Dialogue: 0,0:19:44.99,0:19:46.59,Main,NTP,0,0,0,,‫الأمر بديهيٌ.
Dialogue: 0,0:19:47.45,0:19:49.95,Main,NTP,0,0,0,,‫العدم... لن يتبقى منها شيء.
Dialogue: 0,0:19:50.46,0:19:54.15,Main,NTP,0,0,0,,‫سيغدو الأمر وكأنها لم توجد في أي عالمٍ قط.
Dialogue: 0,0:19:54.58,0:19:58.30,Main,NTP,0,0,0,,‫الأحياء والأموات...\N‫سينساها الجميع عن بكرة أبيهم.
Dialogue: 0,0:19:59.88,0:20:02.28,Main,NTP,0,0,0,,‫ولعل حياتها لم تكن\N‫ذات قيمةٍ تذكر على أي حال.
Dialogue: 0,0:20:02.55,0:20:06.05,Main,NTP,0,0,0,,‫لن يشكل زوال وجود ‫كائنٍ مثلها أي فارق.
Dialogue: 0,0:20:06.51,0:20:08.47,Main,NTP,0,0,0,,‫محالٌ أن يحدث هذا!
Dialogue: 0,0:20:08.47,0:20:10.14,Main,NTP,0,0,0,,‫هذا قاسٍ للغاية!
Dialogue: 0,0:20:10.14,0:20:13.74,Main,NTP,0,0,0,,‫ألا توجد وسيلة؟\N‫أي شيءٍ يجعلها ترقد بسلام؟
Dialogue: 0,0:20:14.19,0:20:18.48,Main,NTP,0,0,0,,‫كلّا، أمر رقادها بسلامٍ ‫مرهونٌ بقلبها وحده.
Dialogue: 0,0:20:18.69,0:20:21.00,Main,NTP,0,0,0,,‫ليس بوسع الغرباء فعل أي شيءٍ حيال ذلك.
Dialogue: 0,0:20:34.92,0:20:39.30,Main,NTP,0,0,0,,‫كم تمنيتُ لو اشتريتُ لكِ\N‫المزيد من الثياب الجميلة.
Dialogue: 0,0:20:43.38,0:20:47.78,Main,NTP,0,0,0,,‫وكم تمنيتُ لو لعبتُ معكِ ‫أكثر.
Dialogue: 0,0:20:48.64,0:20:52.19,Main,NTP,0,0,0,,‫أكثر... كما ينبغي... أكثر...
Dialogue: 0,0:20:53.89,0:20:56.49,Main,NTP,0,0,0,,‫لو لم تولدي ابنةً لي...
Dialogue: 0,0:20:57.65,0:20:59.65,Main,NTP,0,0,0,,‫لكنتِ أسعد حالًا ‫بكثير...
Dialogue: 0,0:21:00.65,0:21:02.65,Main,NTP,0,0,0,,‫أنا من جلبتُ لكِ التعاسة...
Dialogue: 0,0:21:05.41,0:21:06.61,Main,NTP,0,0,0,,‫آسفة للغاية...
Dialogue: 0,0:21:21.80,0:21:23.01,Main,NTP,0,0,0,,‫أمي...
Dialogue: 0,0:21:24.76,0:21:25.76,Main,NTP,0,0,0,,‫أحبكِ.
Dialogue: 0,0:21:32.43,0:21:36.93,Main,NTP,0,0,0,,‫كنتُ أسعد فتاةٍ في الكون بأسره.
Dialogue: 0,0:21:45.40,0:21:49.22,Main,NTP,0,0,0,,‫أرجوك يا إلهي، كي لا يؤذيهما أحدٌ أبدًا...
Dialogue: 0,0:21:52.87,0:21:56.50,Main,NTP,0,0,0,,‫خذهما إلى عالمٍ أسعد ‫وعالمٍ ألطف.
Dialogue: 0,0:22:09.76,0:22:12.16,Main,NTP,0,0,0,,‫لن أنسى، أعدكِ بذلك حتمًا.
Dialogue: 0,0:23:43.48,0:23:44.61,Main,NTP,0,0,0,,‫أعدتِ يا مومو؟
Dialogue: 0,0:23:45.11,0:23:47.28,Main,NTP,0,0,0,,‫لكننا وجدنا كرة واحدةً فحسب.
Dialogue: 0,0:23:47.28,0:23:48.15,Main,NTP,0,0,0,,‫فهمت.
Dialogue: 0,0:23:48.15,0:23:49.69,Main,NTP,0,0,0,,‫أشعر بالجوع يا جدتي.
Dialogue: 0,0:23:49.69,0:23:50.82,Note,NTP,0,0,0,,(سومين: شعيرية يابانية رفيعة مصنوعة من دقيق القمح)
Dialogue: 0,0:23:49.69,0:23:50.82,Main,NTP,0,0,0,,‫أتريدين تناول السومين؟
Dialogue: 0,0:23:50.82,0:23:52.32,Main,NTP,0,0,0,,‫فكرةٌ رائعة!
Dialogue: 0,0:23:52.53,0:23:54.99,Main,NTP,0,0,0,,‫الحلقة القادمة:\N‫"ينتابني هذا الشعور الغريب".
Dialogue: 0,0:23:54.99,0:23:57.50,Main,NTP,0,0,0,,‫نفد المرق على ما يبدو، ‫سأخرج لشراء بعضٍ منه.
